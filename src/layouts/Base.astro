---
import '../style.css';
import theme from '../theme.js?raw';
import interactions from '../script.js?raw';

interface Props {
  preview?: boolean;
  designFonts?: string;
  banner?: boolean;
}
const { preview = false, designFonts, banner = true } = Astro.props;
const title = 'Adil Bains';
const description = 'Adil Bains studies computer science at MSIT and builds software for the web.';
const url = Astro.site!.href;
const image = new URL('social.png', Astro.site).href;
const favicon = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" rx="10" fill="#fff"/><path d="M8 49l18-29 9 14 8-19 13 34H8z" fill="#0a0a0a"/><path d="m19 32 7-12 7 11-7-3z" fill="#fff"/><circle cx="18" cy="17" r="4" fill="#0a0a0a"/></svg>';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={theme}></script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {preview ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={url} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content="Adil Bains above a black ink drawing of a moonlit lake" />
    <link rel="icon" href={`data:image/svg+xml,${encodeURIComponent(favicon)}`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={designFonts ?? "https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500&display=swap"} />
  </head>
  <body>
    <slot />
    {banner && <script is:inline set:html={interactions}></script>}
  </body>
</html>
