---
import { getCollection } from 'astro:content';
import Arrow from '../components/Arrow.astro';
import Banner from '../components/Banner.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Base from '../layouts/Base.astro';
import { editionEntries, editions, sitePath, type Edition } from '../designs/editions';
import { hackathons, introduction, skills } from '../designs/profile';
import '../designs/editions.css';

export function getStaticPaths() {
  return editionEntries.map(([edition]) => ({ params: { edition } }));
}

const edition = Astro.params.edition as Edition;
const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id),
);
const fonts = `https://fonts.googleapis.com/css2?family=${editions[edition].fonts}&display=swap`;
---
<Base preview designFonts={fonts}>
  <div class:list={['edition', edition]} data-edition={edition}>
    <header class="edition-nav">
      <a class="comparison-link" href={sitePath('compare/')}>← Compare designs</a>
      <nav aria-label="Portfolio">
        <a href="#work">Work</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
      </nav>
      <ThemeToggle />
    </header>

    <main>
      <div class="edition-hero">
        {edition === 'landscape' && <Banner edition={edition} />}
        <div class="edition-title">
          <h1>Adil Bains</h1>
          <p class="edition-subtitle">Computer Science &amp; Engineering student at MSIT</p>
          <p class="edition-intro">{introduction}</p>
        </div>
        {edition !== 'landscape' && <Banner edition={edition} />}
      </div>

      <div class="edition-body">
        <div class="edition-primary">
          <section class="edition-work" id="work" aria-labelledby="work-heading">
            <h2 id="work-heading">Selected projects</h2>
            <ul class="edition-projects">
              {projects.map(({ data }) => (
                <li class="edition-project">
                  <div>
                    <h3><a href={data.url}>{data.title} <Arrow /></a></h3>
                    <p>{data.description}</p>
                    {data.detail && <p class="project-detail">{data.detail}</p>}
                  </div>
                  {data.stack.length > 0 && <ul class="project-stack" aria-label="Technologies">{data.stack.map(tool => <li>{tool}</li>)}</ul>}
                </li>
              ))}
            </ul>
          </section>

          <section class="edition-hackathons" aria-labelledby="hackathons-heading">
            <h2 id="hackathons-heading">Hackathons</h2>
            <ul class="hackathon-list">
              {hackathons.map(({ project, event, result, description }) => (
                <li>
                  <div><h3>{project}</h3><p>{event} · {result}</p></div>
                  <p>{description}</p>
                </li>
              ))}
            </ul>
          </section>
        </div>

        <div class="edition-profile" id="about">
          <section aria-labelledby="education-heading">
            <h2 id="education-heading">Education</h2>
            <p class="degree">Maharaja Surajmal Institute of Technology</p>
            <p>B.Tech. in Computer Science &amp; Engineering</p>
            <p>Aug 2024 – Jun 2028 · 9.1/10 CGPA</p>
          </section>
          <section aria-labelledby="skills-heading">
            <h2 id="skills-heading">Technical skills</h2>
            <dl class="skill-list">
              {skills.map(({ label, value }) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
            </dl>
          </section>
        </div>
      </div>
    </main>

    <footer class="edition-footer" id="contact">
      <h2>Contact</h2>
      <div>
        <a href="mailto:adilbains.work@gmail.com">Email <Arrow /></a>
        <a href="https://github.com/ADIBAINS">GitHub <Arrow /></a>
      </div>
      <small>© 2026 Adil Bains</small>
    </footer>
  </div>
</Base>
