---
import lake from '../art/lake.svg?raw';
import arch from '../art/arch.svg?raw';
import ridges from '../art/ridges.svg?raw';
import tower from '../art/tower.svg?raw';

import inkLake from '../art/gothic/lake.svg?url';
import inkArch from '../art/gothic/arch.svg?url';
import inkRidges from '../art/gothic/ridges.svg?url';
import inkTower from '../art/gothic/tower.svg?url';

import type { Edition } from '../designs/editions';

interface Props {
  edition?: Edition;
}
const { edition } = Astro.props;
const original = [
  { name: 'Lake at night', art: lake },
  { name: 'Ruined arch', art: arch },
  { name: 'Ridge lines', art: ridges },
  { name: 'Tower on a crag', art: tower },
];
const engravings = [
  { name: 'Lake at night', image: inkLake, description: 'A crescent moon reflected in a mountain lake.' },
  { name: 'Ruined arch', image: inkArch, description: 'A broken stone arch over a path through the mountains.' },
  { name: 'Ridge lines', image: inkRidges, description: 'Guts looks out across the mountains, with the Dragonslayer rising over his shoulder.' },
  { name: 'Tower on a crag', image: inkTower, description: 'A tower on a rocky outcrop against a ring of eclipse light.' },
];
const openingScene = { manga: 2, manuscript: 1, landscape: 3, monochrome: 0 };
const ordered = edition
  ? engravings.slice(openingScene[edition]).concat(engravings.slice(0, openingScene[edition]))
  : [];
const scenes = edition ? ordered.map(scene => ({ ...scene, art: undefined })) : original.map(scene => ({
  ...scene, image: undefined, description: undefined,
}));
---
<figure data-banner>
  <div class="banner-frame">
    {scenes.map(({ name, art, image, description }, index) => (
      <div class:list={['scene', { 'is-current': index === 0 }]} data-scene={name} aria-hidden={image ? index !== 0 : true}>
        {image ? <img src={image} alt={description} width="1200" height="510" decoding="async" fetchpriority={index === 0 ? 'high' : 'low'} /> : <Fragment set:html={art} />}
      </div>
    ))}
    <button type="button" class="banner-next" aria-label="Next illustration" data-banner-next hidden>
      {edition && <span aria-hidden="true">→</span>}
    </button>
  </div>
  <div class="banner-progress" aria-hidden="true"><span data-banner-progress></span></div>
  <figcaption class="banner-meta">
    <span class="banner-caption" data-banner-caption>{scenes[0].name}</span>
    <button type="button" class="banner-pause" data-banner-pause aria-label="Pause banner rotation" hidden>
      <svg class="pause-icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M5 3v10m6-10v10" stroke="currentColor" stroke-width="1.5"/></svg>
      <svg class="play-icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="m5 2 9 6-9 6z" fill="currentColor"/></svg>
    </button>
    <span class="banner-count" data-banner-count>01 / 04</span>
    <span class="sr-only" role="status" data-banner-status></span>
  </figcaption>
</figure>
