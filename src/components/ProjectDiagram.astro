---
interface Props { project: string }
const { project } = Astro.props;
---
<svg class="project-diagram" viewBox="0 0 320 120" fill="none" aria-hidden="true">
  {project === 'uzip' && <>
    <path d="M72 60h55m66 0h55m-88-19V23m0 56v18" stroke="currentColor" stroke-dasharray="3 4" />
    <rect x="128" y="41" width="64" height="38" rx="6" class="diagram-solid" />
    <path d="M147 60h26m-7-7 7 7-7 7" stroke="var(--diagram-paper)" stroke-width="2" />
    <circle cx="61" cy="60" r="10"/><circle cx="259" cy="60" r="10"/><circle cx="160" cy="18" r="5"/><circle cx="160" cy="102" r="5"/>
  </>}
  {project === 'taskqueue' && <>
    <rect x="55" y="47" width="20" height="26" rx="3"/><rect x="82" y="47" width="20" height="26" rx="3"/><rect x="109" y="47" width="20" height="26" rx="3" class="diagram-solid"/>
    <path d="M137 60h42m0 0v-33h32m-32 33h32m-32 0v33h32" stroke-dasharray="3 4"/>
    <rect x="213" y="17" width="50" height="20" rx="4"/><rect x="213" y="50" width="50" height="20" rx="4"/><rect x="213" y="83" width="50" height="20" rx="4"/>
    <path d="M223 27h17m-17 33h23m-23 33h12"/>
  </>}
  {project === 'travaasa' && <>
    <path d="M62 77 108 35l53 18 51-26 46 17-14 39-49 14-54-17-43 13Z" />
    <path d="m108 35-10 58m63-40-20 27m71-53-17 70M82 62l62 9 50-23 54 11" stroke-dasharray="3 4"/>
    <path d="M154 61s-18-16-18-28a18 18 0 0 1 36 0c0 12-18 28-18 28Z" class="diagram-solid"/>
    <circle cx="154" cy="33" r="6" fill="var(--diagram-paper)" stroke="none"/>
  </>}
</svg>
